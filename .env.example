# ==========================================
# CẤU HÌNH HỆ THỐNG BUDDHIST ENGAGEMENT FACTORY
# ==========================================

# 1. API Keys (Chọn 1 trong 2 hoặc cả hai):
# Lấy Gemini API Key miễn phí tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Hoặc dùng OpenAI API Key:
OPENAI_API_KEY=

# (Tùy chọn) YouTube Data API v3 Key. Nếu để trống, hệ thống sẽ tự động dùng yt-dlp để crawl không cần API key!
YOUTUBE_API_KEY=

# 2. Thông tin Channel mục tiêu cần quảng bá
TARGET_CHANNEL_NAME="1995lido"
TARGET_CHANNEL_HANDLE="@1995lido"
TARGET_CHANNEL_TOPIC="Kênh chia sẻ Phật pháp ứng dụng, podcast chiêm nghiệm cuộc sống, tĩnh tâm, chữa lành và góc nhìn thanh thản cho người trẻ."

# 3. Cấu hình quét và phân tích
SEARCH_KEYWORDS="thuyết pháp Thích Pháp Hòa, thiền buông thư Thích Nhất Hạnh, nghe pháp thoại an lạc, kinh dược sư giảng giải, lời Phật dạy cuộc sống, chữa lành tâm hồn phật giáo"
MAX_VIDEOS_PER_KEYWORD=3
MAX_COMMENTS_PER_VIDEO=25

# 4. Lập lịch tự động (Schedule)
# Khoảng thời gian tự động quét lại (giờ): VD 6 tiếng hoặc 12 tiếng một lần
SCHEDULE_INTERVAL_HOURS=6
